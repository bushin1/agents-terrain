generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Agents ─────────────────────────────────────────────────────────────────────

enum AgentStatus {
  APPLICANT
  TRAINING
  LOCKED
  REFUSED
  CERTIFIED
  ACTIVE
  SUSPENDED
}

enum AgentLevel {
  STARTER
  BRONZE
  SILVER
  GOLD
}

model Agent {
  id               String            @id @default(cuid())
  firstName        String
  lastName         String
  email            String            @unique
  phone            String            @unique // E.164 US
  birthDate        DateTime          @db.Date
  zip              String
  lat              Float
  lng              Float
  radiusMiles      Int
  hasCar           Boolean
  availability     String[] // créneaux « mon-am », « mon-pm », … « sun-pm »
  status           AgentStatus       @default(APPLICANT)
  level            AgentLevel        @default(STARTER)
  trustScore       Int               @default(0)
  phoneVerifiedAt  DateTime?
  failedAttempts   Int               @default(0)
  lastAttemptAt    DateTime?
  selfieKey        String?
  profileAnswers   Json?
  contractVersion  String?
  contractSignedAt DateTime?
  contractSignedName String? // nom légal tapé pour signer
  contractIp       String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  attempts         TrainingAttempt[]
  missions         Mission[]
  earnings         Earning[]
  flags            FraudFlag[]
  taskResults      QuickTaskResult[]

  @@index([status])
  @@index([level])
}

// Codes à usage unique envoyés par SMS (candidature et connexion). Seule l'empreinte est stockée.
model OtpCode {
  id        String    @id @default(cuid())
  phone     String
  codeHash  String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  ip        String? // adresse IP de la demande (limite anti-pompage SMS)

  @@index([phone, createdAt])
  @@index([ip, createdAt])
}

model TrainingAttempt {
  id        String   @id @default(cuid())
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id])
  score     Int // pourcentage 0–100
  passed    Boolean
  answers   Json
  createdAt DateTime @default(now())

  @@index([agentId, createdAt])
}

// ── Pros et missions ───────────────────────────────────────────────────────────

enum ProStatus {
  TO_CALL
  AGREED
  MISSION_OPEN
  VISITED
  LISTING_LIVE
  CLIENT
  LOST
}

model Pro {
  id              String    @id @default(cuid())
  businessName    String
  contactName     String?
  phone           String // E.164 US
  address         String
  city            String
  state           String // code à 2 lettres
  zip             String
  lat             Float?
  lng             Float?
  timeZone        String // IANA, ex. America/New_York
  trade           String
  status          ProStatus @default(TO_CALL)
  notes           String?
  existingPlaceId String? // fiche publique déjà existante avant la visite (à revendiquer)
  lostReason      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  missions        Mission[]

  @@index([status])
  @@index([phone])
}

enum MissionType {
  VISIT
  RETURN_VISIT
  QUICK_TASK
}

enum MissionStatus {
  OPEN
  ACCEPTED
  SUBMITTED
  NEEDS_FIX
  VALIDATED
  REJECTED
  CANCELLED
}

model Mission {
  id                   String        @id @default(cuid())
  proId                String
  pro                  Pro           @relation(fields: [proId], references: [id])
  agentId              String?
  agent                Agent?        @relation(fields: [agentId], references: [id])
  type                 MissionType   @default(VISIT)
  parentMissionId      String? // mission VISIT d'origine, pour une RETURN_VISIT
  parentMission        Mission?      @relation("ReturnOf", fields: [parentMissionId], references: [id])
  returnMissions       Mission[]     @relation("ReturnOf")
  status               MissionStatus @default(OPEN)
  slotAt               DateTime
  publishedAt          DateTime      @default(now())
  acceptedAt           DateTime?
  submittedAt          DateTime?
  validatedAt          DateTime?
  needsFixAt           DateTime?
  fixMessage           String?
  rejectReason         String?
  cancelReason         String?
  broadcastRadiusMiles Int?
  urgencyBonusCents    Int           @default(0)
  suggestedCategory    String
  instructions         String?
  reminderSentAt       DateTime?
  noShowSmsAt          DateTime?
  postVisitSmsAt       DateTime?
  proRating            Int?
  proDenied            Boolean       @default(false)
  charteAcceptedAt     DateTime?
  charteAcceptedIp     String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  submission           Submission?
  taskResult           QuickTaskResult?
  earnings             Earning[]
  flags                FraudFlag[]

  @@index([status, slotAt])
  @@index([agentId, status])
  @@index([proId])
}

// Données de la checklist. `steps` suit le schéma Zod de modules/missions/checklist-rule.ts.
model Submission {
  id        String   @id @default(cuid())
  missionId String   @unique
  mission   Mission  @relation(fields: [missionId], references: [id])
  steps     Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  photos    Photo[]
}

enum PhotoCategory {
  LOGO
  VEHICLE
  TEAM
  EQUIPMENT
  JOB
}

model Photo {
  id           String        @id @default(cuid())
  submissionId String
  submission   Submission    @relation(fields: [submissionId], references: [id])
  storageKey   String        @unique
  category     PhotoCategory
  exifTakenAt  DateTime?
  exifLat      Float?
  exifLng      Float?
  clientAt     DateTime
  receivedAt   DateTime      @default(now())

  @@index([submissionId])
}

// ── Gains ──────────────────────────────────────────────────────────────────────

enum EarningTier {
  VISIT
  LIVE
  CLIENT
  RETURN_VISIT
  URGENCY
  QUICK_TASK
}

enum EarningStatus {
  PAYABLE
  PAID
  VOID
}

model Earning {
  id              String        @id @default(cuid())
  agentId         String
  agent           Agent         @relation(fields: [agentId], references: [id])
  missionId       String
  mission         Mission       @relation(fields: [missionId], references: [id])
  tier            EarningTier
  baseAmountCents Int
  levelBonusPct   Int
  amountCents     Int
  status          EarningStatus @default(PAYABLE)
  voidReason      String?
  voidedBy        String?
  createdAt       DateTime      @default(now())

  @@unique([missionId, tier])
  @@index([agentId, status])
}

// ── Anti-fraude, SMS entrants ──────────────────────────────────────────────────

enum FraudType {
  CHECKIN_FAR
  DUPLICATE_PRO
  PHOTO_EXIF_MISMATCH
  PRO_DENIED
  LOW_PRO_RATING
  NO_SHOW
  LATE_SYNC
  REVIEW_REMOVED
  REVIEW_SUSPICIOUS
}

model FraudFlag {
  id        String    @id @default(cuid())
  missionId String
  mission   Mission   @relation(fields: [missionId], references: [id])
  agentId   String
  agent     Agent     @relation(fields: [agentId], references: [id])
  type      FraudType
  detail    String
  resolved  Boolean   @default(false)
  createdAt DateTime  @default(now())

  @@unique([missionId, agentId, type])
}

model InboundSms {
  id        String   @id @default(cuid())
  fromPhone String
  body      String
  missionId String?
  handled   Boolean  @default(false)
  messageSid String?  @unique // identifiant Twilio (MessageSid) : un renvoi n'est traité qu'une fois
  createdAt DateTime @default(now())

  @@index([handled, createdAt])
}

// ── Back-office ────────────────────────────────────────────────────────────────

enum AdminRole {
  ADMIN
  SETTER
}

model AdminUser {
  email     String    @id
  role      AdminRole
  createdAt DateTime  @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  actor     String // email admin, « agent:<id> » ou « system »
  action    String
  entity    String
  entityId  String
  reason    String?
  data      Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ── Quick Tasks (phase 2) ──────────────────────────────────────────────────────

enum TargetTier {
  SACRIFICIAL
  STANDARD
  PREMIUM
}

model ReviewTarget {
  id           String      @id @default(cuid())
  placeId      String      @unique
  name         String
  city         String
  state        String
  trade        String
  tier         TargetTier  @default(SACRIFICIAL)
  active       Boolean     @default(true)
  maxPerDay    Int         @default(1)
  maxTotal     Int         @default(20)
  reviewCount  Int         @default(0)
  lastReviewAt DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  results      QuickTaskResult[]

  @@index([active, tier])
  @@index([state])
}

enum QuickTaskStatus {
  ASSIGNED
  SUBMITTED
  VERIFIED
  FAILED
  EXPIRED
}

model QuickTaskResult {
  id              String          @id @default(cuid())
  missionId       String          @unique
  mission         Mission         @relation(fields: [missionId], references: [id])
  targetId        String
  target          ReviewTarget    @relation(fields: [targetId], references: [id])
  agentId         String
  agent           Agent           @relation(fields: [agentId], references: [id])
  status          QuickTaskStatus @default(ASSIGNED)
  reviewText      String
  screenshotKey   String?
  verifiedAt      DateTime?
  survivedCheck   Boolean?
  survivedAt      DateTime?
  expiresAt       DateTime
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([agentId, status])
  @@index([targetId, createdAt])
  @@unique([agentId, targetId])
}

// Textes d'avis réels collectés côté gmb-tracker (clients qui ont rempli notre formulaire).
// Injectés via POST /api/internal/review-texts, consommés par assignTask en priorité
// sur les templates génériques pickReviewText().
model PendingReviewText {
  id        String    @id @default(cuid())
  placeId   String    // matches ReviewTarget.placeId
  text      String
  rating    Int       // 1..5 (info only)
  sourceRef String?   // ReviewFunnelResponse.id from gmb-tracker
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([placeId, usedAt])
}
